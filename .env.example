# ======================
# Server
# ======================
PORT=3000

# ======================
# MongoDB
# ======================
MONGOURI=mongodb://localhost:27017/shop

# ======================
# JWT Tokens
# ======================
ACCESSTOKEN_SECRET_KEY=your_access_token_secret_key_here
ACCESSTOKEN_EXPIRE_IN=1d
REFRESHTOKEN_SECRET_KEY=your_refresh_token_secret_key_here
REFRESHTOKEN_EXPIRE_IN=7d

# ======================
# Cookie
# ======================
COOKIE_PARSER=your_cookie_secret_here

# ======================
# Redis
# ======================
REDIS_URI=redis://localhost:6379

# ======================
# SMS Service
# ======================
SMS_API_KEY=your_sms_api_key_here
SMS_PATTERN_CODE=your_sms_pattern_code_here

# ======================
# Zarinpal Payment Gateway
# ======================
ZARINPAL_BASE_URL=https://payment.zarinpal.com/pg/v4/payment/request.json
ZARINPAL_CALLBACK_URL=http://localhost:3000/checkout/verify
ZARINPAL_PAYMENT_URL=https://payment.zarinpal.com/pg/StartPay/
ZARINPAL_VERIFY_URL=https://payment.zarinpal.com/pg/v4/payment/verify.json
ZARINPAL_MERCHANT=your_zarinpal_merchant_id_here
